<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: two lines of text sitting inside a rewrite cycle.
  Stroked, so it stays crisp at every density and reads at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <!-- upper arc, travelling clockwise -->
        <path
            android:pathData="M29.6,45.1 A26,26 0 0 1 78.4,45.1"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
        <path
            android:pathData="M81.8,35.8 L78.4,45.1 L70.8,38.7"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="7" />

        <!-- lower arc, closing the loop -->
        <path
            android:pathData="M78.4,62.9 A26,26 0 0 1 29.6,62.9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
        <path
            android:pathData="M26.2,72.2 L29.6,62.9 L37.2,69.3"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="7" />

        <!-- the text being rewritten -->
        <path
            android:pathData="M40,48 L68,48"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
        <path
            android:pathData="M40,60 L58,60"
        
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
    </group>
</vector>
