<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Paraphase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/accent</item>
    </style>

    <!-- Edge to edge, transparent bars, background painted by AuroraView. -->
    <style name="Theme.Paraphase.Landing" parent="Theme.Paraphase">
        <item name="android:windowBackground">@color/landing_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Floats over whatever app the user was in; the host app stays visible. -->
    <style name="Theme.Paraphase.Overlay" parent="Theme.Material3.DayNight.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="FeatureRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:gravity">top</item>
    </style>

    <style name="FeatureIcon">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="FeatureCopy">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="FeatureTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="FeatureBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:alpha">0.72</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>
</resources>
