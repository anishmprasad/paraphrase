<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Every hosted provider is HTTPS. Cleartext is permitted because a
        self-hosted server (Ollama, LM Studio, llama.cpp) serves plain HTTP on
        the local network, and Android's config cannot express "private address
        ranges only" — the alternative would be to make local models unusable.
        The only cleartext destination is one the user typed in themselves.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
