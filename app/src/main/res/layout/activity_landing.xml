<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/landing_bg">

    <tech.getapps.paraphrase.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp">

            <!-- brand -->
            <LinearLayout
                android:id="@+id/brandRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_app_mark">

                    <ImageView
                        android:id="@+id/appMark"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/app_mark"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_launcher_foreground" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />
            </LinearLayout>

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:lineSpacingMultiplier="1.05"
                android:text="@string/landing_headline"
                android:textAppearance="?attr/textAppearanceDisplaySmall" />

            <TextView
                android:id="@+id/subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.75"
                android:text="@string/landing_sub"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <!-- live demo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/demoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/demo_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:letterSpacing="0.08"
                        android:text="@string/landing_demo_app"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelSmall" />

                    <TextView
                        android:id="@+id/demoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minLines="3"
                        android:text="@string/landing_demo_original"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/fakeToolbar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_fake_toolbar"
                            android:elevation="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:text="@string/landing_cut"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:text="@string/landing_copy"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                            <TextView
                                android:id="@+id/toolbarParaphrase"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_toolbar_highlight"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="@string/action_paraphrase"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:paddingHorizontal="8dp"
                                android:text="@string/landing_more"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/demoStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="invisible">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/landing_demo_replaced"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/replayHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.45"
                android:gravity="center"
                android:text="@string/landing_demo_replay"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <HorizontalScrollView
                android:id="@+id/chipScroller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/styleChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- features -->
            <LinearLayout
                android:id="@+id/feature1"
                style="@style/FeatureRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/FeatureIcon"
                    android:src="@drawable/ic_apps"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    style="@style/FeatureCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/FeatureTitle"
                        android:text="@string/feature_1_title" />

                    <TextView
                        style="@style/FeatureBody"
                        android:text="@string/feature_1_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feature2"
                style="@style/FeatureRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/FeatureIcon"
                    android:src="@drawable/ic_spark"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    style="@style/FeatureCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/FeatureTitle"
                        android:text="@string/feature_2_title" />

                    <TextView
                        style="@style/FeatureBody"
                        android:text="@string/feature_2_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feature3"
                style="@style/FeatureRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/FeatureIcon"
                    android:src="@drawable/ic_bolt"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    style="@style/FeatureCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/FeatureTitle"
                        android:text="@string/feature_3_title" />

                    <TextView
                        style="@style/FeatureBody"
                        android:text="@string/feature_3_body" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ctaButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:paddingVertical="16dp"
                android:text="@string/landing_cta"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/landing_skip" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />
</FrameLayout>
