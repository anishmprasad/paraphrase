<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Paraphrase">

        <!-- The landing page is the launcher entry; it forwards straight to
             setup once it has been seen. -->
        <activity
            android:name=".LandingActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Paraphrase.Landing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The text-selection popup entry. Android shows this activity's label
            ("Paraphrase") in the floating selection toolbar of every app.
            When the selection is editable, whatever we put back into
            EXTRA_PROCESS_TEXT replaces the selected text in place.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_paraphrase"
            android:label="@string/action_paraphrase"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Paraphrase.Overlay">
            <!--
                Position in the selection toolbar is not ours to choose. AOSP's
                Editor hardcodes Cut/Copy/Paste/Share/Select all at menu orders
                4-11 and starts every PROCESS_TEXT action at 100, so a third
                party can never sit among the built-ins. android:priority does
                not help either: the platform zeroes intent-filter priority for
                non-system apps (verified on device — it stores priority=0).
                Do not re-add it; it is a no-op that reads like a fix.
            -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Also usable from any app's Share sheet (read-only result). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
